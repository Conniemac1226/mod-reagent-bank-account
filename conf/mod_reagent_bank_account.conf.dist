[worldserver]

#
# Standalone Reagent Bank Account
#

#
#    ReagentBankAccount.Enable
#        Description: Enables the standalone .rbank command API used by the addon.
#        Default:     1
#
ReagentBankAccount.Enable = 1

#
#    ReagentBankAccount.AccountWide
#        Description: 0 = storage is per character.
#                     1 = storage is shared by all characters on the same account.
#        Default:     1
#
ReagentBankAccount.AccountWide = 1

#    ReagentBankAccount.EnableNpc
#        Description: Keep banker NPC integration enabled.
#                     Standalone addon/chat-command access works with this disabled.
#        Default:     0 - Disabled
#                     1 - Enabled
ReagentBankAccount.EnableNpc = 0

#
#    ReagentBankAccount.AutoMigrate
#        Description: Automatically rewrites mod_reagent_bank_account rows when
#                     ReagentBankAccount.AccountWide changes.
#                     Character -> Account: sums all characters on the same account.
#                     Account -> Character: moves the shared account bank to the
#                     account's lowest GUID character because original ownership
#                     cannot be reconstructed after account-wide merge.
#        Default:     1
#
ReagentBankAccount.AutoMigrate = 1

#
#    ReagentBankAccount.MaxItemsPerPage
#        Description: Number of stored item rows returned to the addon per category page.
#                     Kept capped at 50 in C++ to avoid excessive chat protocol traffic.
#        Default:     16
#
ReagentBankAccount.MaxItemsPerPage = 16

#
#    ReagentBankAccount.EnableSharing
#        Description: Enables reagent bank sharing between players.
#                     AccountWide = 1: sharing is account-to-account (all characters on
#                                      each account see the shared bank).
#                     AccountWide = 0: sharing is character-to-character (only the invited
#                                      character sees the shared bank; other characters on
#                                      the same account are unaffected and may hold
#                                      independent share relationships).
#                     Members' items merge into the owner's bank on join.
#                     Items remain in the owner's bank if a member leaves or is kicked.
#
#                     WARNING: Do not change AccountWide after players have established
#                     share relationships. On mode change, all share memberships are
#                     cleared automatically, but items stay wherever they were at the
#                     time of the switch (i.e. merged into whichever bank accepted them).
#                     There is no way to reconstruct original ownership after a merge.
#                     Treat AccountWide as a set-and-forget option when sharing is in use.
#        Default:     0
#
ReagentBankAccount.EnableSharing = 0

#
#    ReagentBankAccount.BotAutoDeposit.Enable
#        Description: Automatically deposits compatible items carried by playerbots.
#                     Real player sessions are never affected.
#                     Enabling this by config reload requires eligible bots to relog.
#        Default:     0
#
ReagentBankAccount.BotAutoDeposit.Enable = 0

#
#    ReagentBankAccount.BotAutoDeposit.OnLogin
#        Description: Schedules an auto-deposit shortly after an eligible bot logs in.
#                     When disabled, the first deposit waits for IntervalSeconds.
#        Default:     1
#
ReagentBankAccount.BotAutoDeposit.OnLogin = 1

#
#    ReagentBankAccount.BotAutoDeposit.IntervalSeconds
#        Description: Seconds between periodic bot auto-deposits.
#                     0 disables periodic deposits, allowing login-only operation.
#                     Non-zero values are clamped to 30-86400 seconds.
#        Default:     300
#
ReagentBankAccount.BotAutoDeposit.IntervalSeconds = 300

#
#    ReagentBankAccount.BotAutoDeposit.LoginDelaySeconds
#        Description: Base delay before a login auto-deposit. Clamped to 1-3600 seconds.
#        Default:     5
#
ReagentBankAccount.BotAutoDeposit.LoginDelaySeconds = 5

#
#    ReagentBankAccount.BotAutoDeposit.RetrySeconds
#        Description: Retry delay when a bot is fighting, casting, trading, in flight,
#                     teleporting, or otherwise unsafe to modify. Clamped to 5-300 seconds.
#        Default:     30
#
ReagentBankAccount.BotAutoDeposit.RetrySeconds = 30

#
#    ReagentBankAccount.BotAutoDeposit.StaggerSeconds
#        Description: Adds a random 0-N second delay to each bot's initial schedule so
#                     several alt bots do not deposit at the same instant. Maximum: 300.
#        Default:     15
#
ReagentBankAccount.BotAutoDeposit.StaggerSeconds = 15

#
#    ReagentBankAccount.BotAutoDeposit.AccountIds
#        Description: Comma-separated account IDs allowed to use bot auto-deposit.
#                     Empty means every playerbot account. Use your account ID here to
#                     leave random bots and bots belonging to other accounts untouched.
#        Example:     "1, 7"
#        Default:     ""
#
ReagentBankAccount.BotAutoDeposit.AccountIds = ""

#
#    ReagentBankAccount.BotAutoDeposit.RetainItemCounts
#        Description: Comma-separated itemEntry:amount pairs kept in each bot's bags.
#                     Only amounts above the retained count are auto-deposited. This is
#                     useful for class reagents, explosives, devices, and crafting tools.
#        Example:     "21177:20, 17020:20"
#        Default:     ""
#
ReagentBankAccount.BotAutoDeposit.RetainItemCounts = ""
